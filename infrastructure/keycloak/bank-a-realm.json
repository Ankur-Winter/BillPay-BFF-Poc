{
  "realm": "bank-a",
  "enabled": true,
  "displayName": "Bank A Demo",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "bank-a-user" }
    ]
  },
  "clientScopes": [
    {
      "name": "bank-a-user-profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "preferred-username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "service-a-api",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "service-a-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "service-a-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "bank-a-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "service-a-api",
      "name": "Bank A Service API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "bank-a-bff",
      "name": "Bank A BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "__BANK_A_BFF_CLIENT_SECRET__",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5101/signin-oidc"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "defaultClientScopes": [
        "bank-a-user-profile"
      ],
      "optionalClientScopes": [
        "service-a-api"
      ]
    }
  ],
  "users": [
    {
      "username": "bank-a-user",
      "enabled": true,
      "email": "bank-a-user@example.test",
      "emailVerified": true,
      "firstName": "Bank A",
      "lastName": "Demo User",
      "credentials": [
        {
          "type": "password",
          "value": "__BANK_A_USER_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "bank-a-user"
      ]
    }
  ]
}
