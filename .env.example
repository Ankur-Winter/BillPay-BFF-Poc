# Do not put real credentials here. Copy this file to .env, then run
# python3 scripts/prepare-local-config.py to generate independent Bank A/Bank B
# secrets and Keycloak realm imports.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=GENERATE_KEYCLOAK_ADMIN_PASSWORD
BANK_A_BFF_CLIENT_SECRET=GENERATE_BANK_A_BFF_CLIENT_SECRET
BANK_B_BFF_CLIENT_SECRET=GENERATE_BANK_B_BFF_CLIENT_SECRET
BANK_A_USER_PASSWORD=GENERATE_BANK_A_USER_PASSWORD
BANK_B_USER_PASSWORD=GENERATE_BANK_B_USER_PASSWORD
